// controller.c 

//work good on simulator a few things you could trail to improve on track is

//if wobbly on straight
    //lower KSYNC first and than maybe  SENSOR_BIAS_GAIN

//if opposite so it drift wide and slow to correct em
    //rasise KSYNC or SENSOR_BIAS_GAIN

//if speed is not steady. changing up n down
    //lower KVP than KVI

//if  speed laggimg 
    //make KVI high

//if RUNNING WIDE  not go into corners nice
    //make WHEEL_SLEW lower

//hard turning
    //make SENSE_GUARD_MM

//if not checking crossbar/markers correctly
    //chsnge MARKER_LEAD_MM and MARKER_MIN_BITS

//if car not start properly
    //increas FF_OFFSET_PWM or  ACCEL_UP


#include "racer.h"
#include <stdint.h>

//tye geometry of car and track 
#define CLKS_PER_REV          360L
#define DIST_PER_REV_X1000    94248L
#define HALF_TRACK_MM         60L
#define ANGLE90_X1000         1571L
#define FIRST_LAP_MOVE0_MM    460
#define SENSOR_AHEAD_MM       60L   // dist axcel to sens bar (cals is car_length/2 )
#define SENSOR_SPACING_X10    95L   // sensor pitch in 0.1mm 

//motor control
//this math to calc pwm needed befre the errors happned
//hard code kinda yk
// pwm = FF_OFFSET_PWM + clicks_per_step * FF_PWM_PER_CPS_X100 / 100
// Derived from Kb=0.0521 V.s/rad, 7.2 V @ 255, 5 ms step, 360 clicks/rev,
// rolling loss Tv=0.002 Nm with R/Km = 133 ohm/Nm/A.
#define FF_OFFSET_PWM         10
#define FF_PWM_PER_CPS_X100   644
#define MAX_PWM               150

//spped
// pi, var to make acceloration smooth
#define SPEED_FILTER 4   
#define KVP   4   // pwm per cpsx16
#define KVI   2
#define V_INTEG_MAX  1500
#define ACCEL_UP   3  // max change  reference cpsx16
#define ACCEL_DOWN   6
#define WHEEL_SLEW  8   //mac change setpoint cpsx16

//var for steering
#define KSYNC 2  // cps x16 of wheel differential per click of error
#define SYNC_MAX16 48 
#define SENSOR_BIAS_GAIN 12 //clicks heading bias pe sens weight
#define BIAS_MAX16  (40*16) //for heading bias
#define BIAS_FILTER  8 //use to help heading bias
#define SENSE_GUARD_MM  70 //ignore sensors close the sens end 

//cross bar 
#define MARKER_MIN_BITS 5 //maybe change should be good how many uses 
#define MARKER_LEAD_MM 72   //axel to crossbar sens
#define MARKER_TOL_MM 80 //ignores if it futher tyhan this
#define MARKER_MIN_PCT 50  //this used to tery find crossbar at end straight as backup feature
//sped for  pwm 
#define V_STRAIGHT 186 //85 PWM
#define V_CURVE 124 //60 PWM
#define V_TIGHT 112 // 55 PWM
#define MOVE_STRAIGHT  0
#define MOVE_CURVE 1
#define DIR_LEFT -1
#define DIR_RIGHT  1

typedef struct {
    uint8_t type;
    int16_t mm; //straight length, or curve radius
    int8_t  dir; //DIR_LEFT / DIR_RIGHT for curves (matches the sim geometry)
    int16_t entry, vmax, exit;
} segment_t;

//the track , order , dist, direction, speeds
static const segment_t TRACK[] = {
    { MOVE_STRAIGHT,  800,  0,         V_TIGHT, V_STRAIGHT, V_TIGHT },
    { MOVE_CURVE,     100,  DIR_RIGHT, V_TIGHT, V_TIGHT,    V_TIGHT },
    { MOVE_CURVE,     100,  DIR_LEFT,  V_TIGHT, V_TIGHT,    V_TIGHT },
    { MOVE_STRAIGHT,  500,  0,         V_TIGHT, V_STRAIGHT, V_CURVE },
    { MOVE_CURVE,     200,  DIR_RIGHT, V_CURVE, V_CURVE,    V_CURVE },
    { MOVE_STRAIGHT,  250,  0,         V_CURVE, V_STRAIGHT, V_CURVE },
    { MOVE_CURVE,     200,  DIR_RIGHT, V_CURVE, V_CURVE,    V_CURVE },
    { MOVE_STRAIGHT, 1150,  0,         V_CURVE, V_STRAIGHT, V_CURVE },
    { MOVE_CURVE,     150,  DIR_RIGHT, V_CURVE, V_CURVE,    V_CURVE },
    { MOVE_CURVE,     150,  DIR_LEFT,  V_CURVE, V_CURVE,    V_CURVE },
    { MOVE_STRAIGHT,  300,  0,         V_CURVE, V_STRAIGHT, V_CURVE },
    { MOVE_CURVE,     150,  DIR_RIGHT, V_CURVE, V_CURVE,    V_CURVE },
    { MOVE_CURVE,     150,  DIR_RIGHT, V_CURVE, V_CURVE,    V_CURVE },
    { MOVE_CURVE,     100,  DIR_LEFT,  V_CURVE, V_TIGHT,    V_TIGHT },
    { MOVE_CURVE,     150,  DIR_RIGHT, V_TIGHT, V_CURVE,    V_CURVE },
};

#define NUM_SEGMENTS (sizeof(TRACK) / sizeof(TRACK[0]))

//states to control the prohgram
static uint8_t  seg_idx = 0;
static uint8_t  first_lap = 1;
static uint8_t  state_initialized = 0;
static const segment_t *seg;

static int32_t prog_l, prog_r, target_l, target_r;
static int32_t guard_clicks;
static int16_t sense_offset16; // sensor reading expected on a perfect arc (weight x16)
static uint8_t marker_done;
static int16_t bias16; // heading bias from sensors (clicks x16)
static int16_t vref16; // current reference-wheel speed (cps x16)
static int16_t spd_l, spd_r; // filtered measured speed (cps x16)
static int16_t i_l, i_r;
static int16_t vs_l, vs_r;  // slew-limited wheel set-points

static const int8_t SENSOR_WEIGHTS[8] = { -7, -5, -3, -1, 1, 3, 5, 7 };

//calculations
//convert the mm to clicks
static inline int32_t mm_to_clicks(int32_t mm) {
    return (mm * CLKS_PER_REV * 1000L) / DIST_PER_REV_X1000;
}



//calc pwm 
static int16_t cps16_to_pwm(int16_t v16) {
    if (v16 <= 0) return 0;
    return (int16_t)(FF_OFFSET_PWM + ((int32_t)v16 * FF_PWM_PER_CPS_X100) / 1600L);
}

//this clamps max min velocity 
//co speed isnt to high or low
static int16_t clamp16(int32_t v, int16_t low, int16_t high) {
    if (v < low) return low;
    if (v > high) return high;
    return (int16_t)v;
}

//calc inteeger square root
static int32_t isqrt32(int32_t n) {
    int32_t r = 0;
    while ((r + 1) * (r + 1) <= n) r++;
    return r;
}

//intialise state
static void init_current_state(int32_t carry_l, int32_t carry_r) {
    seg = &TRACK[seg_idx];
    prog_l = carry_l;
    prog_r = carry_r;
    i_l = 0;
    i_r = 0;
    bias16 = 0;
    marker_done = 0;
    sense_offset16 = 0;

    int32_t ref_mm;
    if (seg->type == MOVE_STRAIGHT) {
        int32_t len = seg->mm;
        if (seg_idx == 0 && first_lap){
          len = FIRST_LAP_MOVE0_MM;  
        } 
        target_l = mm_to_clicks(len);
        target_r = target_l;
        ref_mm = len;
    } else {
        int32_t r = seg->mm;
        int32_t outer = (r + HALF_TRACK_MM) * ANGLE90_X1000 / 1000L;
        int32_t inner = (r - HALF_TRACK_MM) * ANGLE90_X1000 / 1000L;
        if (seg->dir == DIR_LEFT) {
             target_l = mm_to_clicks(inner); target_r = mm_to_clicks(outer); 
            }else { 
                target_l = mm_to_clicks(outer); target_r = mm_to_clicks(inner);
             }
        ref_mm = r * ANGLE90_X1000 / 1000L;// this is the centre line arc left (centre of it nor sidee)

        //SENSOR_AHEAD as sensiror is in front of the axle
        //so arc sees the offset line yk
        // sees line offset when turn
        //may need fix to work out how much offset and that yk
        int32_t a2 = SENSOR_AHEAD_MM * SENSOR_AHEAD_MM;
        int32_t y10 = r * 10 - isqrt32((r * r - a2) * 100);
        sense_offset16 = (int16_t)(seg->dir * (y10 * 32L) / SENSOR_SPACING_X10);
    }

    int32_t ref_target = (target_l >= target_r) ? target_l : target_r;
    guard_clicks = ref_target * SENSE_GUARD_MM / ref_mm;
    if (guard_clicks > ref_target) guard_clicks = ref_target;

    state_initialized = 1;
}

static void next_segment(void) {
    int32_t over_l = prog_l - target_l; 
    if (over_l < 0){
       over_l = 0; 
    }  
    if (over_l > 20){
       over_l = 20; 
    } 
    int32_t over_r = prog_r - target_r; 
    if (over_r < 0){
      over_r = 0;  
    }  
    if (over_r > 20){
        over_r = 20;
    } 
    seg_idx++;
    if (seg_idx >= NUM_SEGMENTS) {
         seg_idx = 0; first_lap = 0; 
        }
    init_current_state(over_l, over_r);
}

//sppeed profile
//for ref wheels
 // ramp entry and exits
static int16_t spr_speed(int32_t ref_prog, int32_t ref_target) {
    if (ref_prog < 0) {
        ref_prog = 0;
    }
    if (ref_prog > ref_target){
       ref_prog = ref_target; 
    } 
    int16_t p = (int16_t)((ref_prog * 1000L) / ref_target);
    if (p < 250){
      return seg->entry + (int16_t)(((int32_t)(seg->vmax - seg->entry) * p) / 250);  
    } 
    if (p < 750){
      return seg->vmax;  
    } 
    return seg->vmax - (int16_t)(((int32_t)(seg->vmax - seg->exit) * (p - 750)) / 250);
}

//the pi on filter spped
//allow the feed forward to work proper
static int16_t wheel_pwm(int16_t vset16, int16_t vmeas16, int16_t *integ) {
    int16_t e = vset16 - vmeas16;
    *integ = clamp16((int32_t)*integ + e, -V_INTEG_MAX, V_INTEG_MAX);
    int32_t pwm = cps16_to_pwm(vset16) + ((int32_t)e * KVP) / 16 + ((int32_t)*integ * KVI) / 256;
    return clamp16(pwm, 0, MAX_PWM);
}


//intilise racer
void racer_init(void) {
    seg_idx = 0;
    first_lap = 1;
    vref16 = 0;
    spd_l = spd_r = 0;
    vs_l = vs_r = 0;
    init_current_state(0, 0);
}

//racer control
void racer_control_step(void) {
    //read inputs
    int16_t lenc = read_left_enc();
    int16_t renc = read_right_enc();
    uint8_t sensors = read_sensors();

    //intalise state
    if (!state_initialized){
      init_current_state(0, 0);   
    }

    //update the car whereabouts
    //monitor and adjust the speed 
    prog_l += lenc;
    prog_r += renc;
    spd_l += ((lenc * 16) - spd_l) / SPEED_FILTER;
    spd_r += ((renc * 16) - spd_r) / SPEED_FILTER;

    uint8_t l_is_ref = (target_l >= target_r);
    int32_t ref_target = l_is_ref ? target_l : target_r;

    //reads the sensors
    uint8_t count = 0;
    int16_t sum = 0;
    for (uint8_t i = 0; i < 8; i++) {
        if (sensors & (1 << i)) { 
            sum += SENSOR_WEIGHTS[i]; count++; 
        }
    }

    //crossbar check
      if (seg->type == MOVE_STRAIGHT && !marker_done && count >= MARKER_MIN_BITS &&
        prog_l * 100 > ref_target * MARKER_MIN_PCT) {
        marker_done = 1;
        int32_t delta = (ref_target - mm_to_clicks(MARKER_LEAD_MM)) - prog_l;
        int32_t tol = mm_to_clicks(MARKER_TOL_MM);
        if (delta >= -tol && delta <= tol) { 
            prog_l += delta; prog_r += delta; 
        }
    }

    //change segment
    //end segmant than  go to nect
    int32_t ref_prog = l_is_ref ? prog_l : prog_r;
    if (ref_prog >= ref_target) {
        next_segment();
        l_is_ref = (target_l >= target_r);
        ref_target = l_is_ref ? target_l : target_r;
        ref_prog = l_is_ref ? prog_l : prog_r;
    }

    // important to allow the work ahread yk
    //ignore crossbar when in section
    //so if the code working as designed it will not need the crossbar to tell it is in next section
    //however crossbar detction icluded as a fail safe
    //thos allow the sensors in the last bit of each segment to be ignored when in next seg already
    //also ogffset where the sensor see on arc
    if (count > 0 && count < MARKER_MIN_BITS && (ref_target - ref_prog) > guard_clicks) {
        int16_t err16 = (int16_t)((sum * 16) / count) - sense_offset16;
        int32_t tgt = (int32_t)err16 * SENSOR_BIAS_GAIN;
        tgt = clamp16(tgt, -BIAS_MAX16, BIAS_MAX16);
        bias16 += (int16_t)((tgt - bias16) / BIAS_FILTER);
    }

    //ref speed
    //convert pwm eq to click per sec
    int16_t vtarget16 = spr_speed(ref_prog, ref_target);
    if (vtarget16 > vref16 + ACCEL_UP){
        vref16 += ACCEL_UP;
    }  else if (vtarget16 < vref16 - ACCEL_DOWN){       
      vref16 -= ACCEL_DOWN;  
    }  else  {
         vref16 = vtarget16;
    }         
    
      

    //wheel speed
    //outer wheel get ref speed
    //inner wheel clc speed by ratio oof the arc
    //also speed change gradual to eliminate acceloration spikes 
    int16_t vset_l, vset_r;
    int32_t err_l = 0, err_r = 0;   // clicks the wheel is behind where it should be
    if (l_is_ref) {
        vset_l = vref16;
        vset_r = (int16_t)(((int32_t)vref16 * target_r) / target_l);
        err_r = (prog_l * target_r) / target_l - prog_r;
    } else {
        vset_r = vref16;
        vset_l = (int16_t)(((int32_t)vref16 * target_l) / target_r);
        err_l = (prog_r * target_l) / target_r - prog_l;
    }
    int32_t diff16 = (err_l - err_r) * 16 + bias16;           // >0: turn right
    int16_t steer = clamp16((diff16 * KSYNC) / 16, -SYNC_MAX16, SYNC_MAX16);
    vset_l += steer / 2;
    vset_r -= steer / 2;
    if (vset_l < 0) vset_l = 0;
    if (vset_r < 0) vset_r = 0;
    vs_l += clamp16((int32_t)vset_l - vs_l, -WHEEL_SLEW, WHEEL_SLEW);
    vs_r += clamp16((int32_t)vset_r - vs_r, -WHEEL_SLEW, WHEEL_SLEW);

    //set the speed of motor
    int16_t left_pwm  = wheel_pwm(vs_l, spd_l, &i_l);
    int16_t right_pwm = wheel_pwm(vs_r, spd_r, &i_r);
    set_speeds(left_pwm, right_pwm);
}

